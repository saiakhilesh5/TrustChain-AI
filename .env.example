# TrustChain-AI — Gemini API keys
# Copy this file to .env and paste one key per slot.
# When a key hits its rate limit the client automatically rotates to the next one.
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3
GEMINI_API_KEY_4=your-gemini-api-key-4
GEMINI_API_KEY_5=your-gemini-api-key-5
GEMINI_API_KEY_6=your-gemini-api-key-6

# Optional overrides
# TRUSTCHAIN_MODEL=gemini-3.8-flash   (falls back to gemini-3.5-flash, gemini-2.5-flash)
